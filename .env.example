BOT_TOKEN=
CHAT_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_PUSH_ENABLED=false
TELEGRAM_ALERT_SIGNALS=STRONG_BUY,BUY,WATCH
TELEGRAM_ALERT_INTERVAL_MINUTES=5
TELEGRAM_ALERT_RETENTION_DAYS=7
