APP_NAME=SportsHunter-AI
ENVIRONMENT=production
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=sqlite:///./sports_hunter.db
LOG_LEVEL=INFO
LOG_FILE=logs/sports_hunter.log
TIMEZONE=Asia/Shanghai

ENABLED_SPORTS=football
ENABLE_SCHEDULER=true
ENABLE_DEMO_FEED=false
DATA_PROVIDER=free
FOOTBALL_DATA_SOURCE=free
FOOTBALL_DATA_SEASON=2026
FREE_PROVIDER_SOURCES=espn,thesportsdb
FREE_PROVIDER_BASE_URL=https://site.api.espn.com
FREE_PROVIDER_THESPORTSDB_BASE_URL=https://www.thesportsdb.com/api/v1/json/3
FREE_PROVIDER_FOOTBALL_LEAGUES=eng.1,eng.2,eng.3,eng.4,eng.5,eng.fa,eng.fa_qual,eng.league_cup,eng.trophy,eng.charity,esp.1,esp.2,esp.copa_del_rey,esp.super_cup,ita.1,ita.2,ita.coppa_italia,ita.super_cup,ger.1,ger.2,ger.dfb_pokal,ger.super_cup,fra.1,fra.2,fra.coupe_de_france,fra.super_cup,por.1,por.taca.portugal,ned.1,ned.2,ned.cup,ned.supercup,sco.1,sco.2,sco.tennents,sco.cis,sco.challenge,bel.1,sui.1,aut.1,den.1,nor.1,swe.1,pol.1,tur.1,gre.1,rus.1,uefa.champions,uefa.champions_qual,uefa.europa,uefa.europa_qual,uefa.europa.conf,uefa.europa.conf_qual,uefa.super_cup,uefa.nations,uefa.euro,uefa.euroq,fifa.world,fifa.wwc,fifa.cwc,fifa.worldq.uefa,fifa.worldq.conmebol,fifa.worldq.concacaf,fifa.worldq.afc,fifa.worldq.caf,fifa.worldq.ofc,fifa.friendly,fifa.friendly.w,fifa.friendly_u21,fifa.world.u20,fifa.world.u17,club.friendly,nonfifa,conmebol.libertadores,conmebol.sudamericana,conmebol.america,concacaf.champions,concacaf.champions_cup,concacaf.gold,concacaf.nations.league,afc.champions,afc.cup,afc.asian.cup,aff.championship,caf.champions,caf.confed,caf.w.nations,kor.1,kor.2,jpn.1,jpn.2,aus.1,chn.1,idn.1,tha.1,sgp.1,ind.1,ind.2,ksa.1,isr.1,rsa.1,bra.1,bra.2,bra.copa_do_brazil,bra.camp.carioca,bra.camp.paulista,bra.camp.gaucho,bra.camp.mineiro,arg.1,arg.2,arg.3,arg.copa,usa.1,usa.nwsl,usa.open,usa.usl.1,usa.usl.l1,mex.1,mex.2,col.1,col.copa,ecu.1,per.1,uru.1,uru.2,chi.1,par.1,bol.1,ven.1,hon.1,crc.1,gua.1,slv.1
ODDS_AGGREGATOR_ENABLED=false
ODDS_AGGREGATOR_PROVIDER=the_odds_api
THE_ODDS_API_KEY=
THE_ODDS_API_BASE_URL=https://api.the-odds-api.com
THE_ODDS_API_REGIONS=uk,eu
THE_ODDS_API_BOOKMAKERS=
THE_ODDS_API_MARKETS=h2h,spreads,totals
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_LIVE_ODDS_ENABLED=true
API_FOOTBALL_LIVE_INCLUDE_PREMATCH=false
API_FOOTBALL_PREMATCH_WINDOW_MINUTES=90
API_FOOTBALL_PREMATCH_GRACE_MINUTES=10
API_FOOTBALL_PREMATCH_CACHE_TTL_SECONDS=1800
API_FOOTBALL_LIVE_CACHE_TTL_SECONDS=300
API_FOOTBALL_BOOKMAKER_IDS=
API_FOOTBALL_BET_IDS=
API_FOOTBALL_ODDS_MAX_PAGES=1

TELEGRAM_ENABLED=false
BOT_TOKEN=
CHAT_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_PUSH_ENABLED=false
TELEGRAM_ALERT_SIGNALS=STRONG_BUY,BUY,WATCH
TELEGRAM_ALERT_INTERVAL_MINUTES=5
TELEGRAM_ALERT_RETENTION_DAYS=7
TELEGRAM_ALERT_ARCHIVE_PATH=reports/telegram_alerts.json

RECOMMENDATION_GATE_ENABLED=true
RECOMMENDATION_ALLOWED_SIGNALS=STRONG_BUY,BUY
RECOMMENDATION_MIN_SCORE=82
RECOMMENDATION_MIN_CONFIDENCE=0.62
RECOMMENDATION_PREMATCH_MIN_MINUTES=15
RECOMMENDATION_PREMATCH_MAX_MINUTES=360
RECOMMENDATION_REQUIRE_ODDS=true
RECOMMENDATION_MIN_MARKET_EDGE=0.04
RECOMMENDATION_MIN_EXPECTED_VALUE=0
RECOMMENDATION_LEAGUE_REVIEW_DAYS=15
RECOMMENDATION_LEAGUE_MIN_SAMPLES=5
RECOMMENDATION_LEAGUE_MIN_HIT_RATE=0.40
RECOMMENDATION_LEAGUE_MIN_ROI=-0.15

HISTORY_COLLECTION_ENABLED=true
EVALUATION_ENABLED=true
AUTOMATION_ENABLED=true
MODEL_OPTIMIZER_ENABLED=true
MODEL_OPTIMIZER_CHECK_HOUR=1
MODEL_OPTIMIZER_CHECK_MINUTE=20
MODEL_OPTIMIZER_MANUAL_MIN_SAMPLES=20
MODEL_OPTIMIZER_AUTO_APPLY_ENABLED=true
MODEL_OPTIMIZER_AUTO_APPLY_MIN_SAMPLES=100
MODEL_OPTIMIZER_STATUS_PATH=reports/model_optimizer_status.json

# Automatic display translation for unknown league/team names.
AUTO_TRANSLATION_ENABLED=true
TRANSLATION_CACHE_PATH=/app/data/translation_cache.json
