APP_NAME=SportsHunter-AI
ENVIRONMENT=production
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=sqlite:///./sports_hunter.db
LOG_LEVEL=INFO
LOG_FILE=logs/sports_hunter.log
TIMEZONE=Asia/Shanghai

ENABLED_SPORTS=football
ENABLE_SCHEDULER=true
